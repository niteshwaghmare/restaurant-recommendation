# ==========================================
# LLM / AI / Data (Crucial for AI projects)
# ==========================================
# Never commit large model weights, embeddings, or local vector databases
*.bin
*.pt
*.pth
*.pkl
*.h5
*.gguf
*.onnx

# Local model cache directories (Hugging Face, etc.)
.cache/
hf_cache/
models/
weights/

# Vector DB storage (e.g., ChromaDB, FAISS, Milvus local files)
chroma_db/
faiss_index/
data/
storage/

# Large log files from tracing/evals (LangChain, LangSmith, Phoenix, etc.)
*.log
eval_results/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
# Never commit your OpenAI, Anthropic, or database credentials!
.env
.env.[a-zA-Z]*
!.env.example     # DO commit the example template to show required keys
.secrets
*.pem
*.key

# ==========================================
# Docker & System Files
# ==========================================
# Ignore local docker overrides if used purely for local debugging
docker-compose.override.yml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

